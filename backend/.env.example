# Copy this file to .env and fill in real values. Never commit .env.
#
# MongoDB Atlas connection string for YOUR cluster.
# Atlas > Cluster > Connect > Drivers. Network Access must allow 0.0.0.0/0
# for the Render free tier, which has no fixed outbound IP.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/homebites

# Random secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste-a-random-hex-string-here
